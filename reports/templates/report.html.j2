{# Jinja2 template for the HTML rendering of a per-target report. Same
   context dict as report.md.j2 (see reports/generator.py's build()) --
   rendered independently rather than by converting the Markdown output,
   so this has no dependency on a markdown-to-HTML library and can use
   real semantic markup (tables, severity badges) directly. #}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Scorpion Bug Hunter -- {{ target.raw_input }}</title>
<style>
  :root {
    --bg: #0b0e14; --panel: #131720; --text: #e6e6e6; --muted: #9aa4b2;
    --crit: #ff4d4f; --high: #ff8a3d; --med: #ffd43b; --low: #74c0fc; --info: #868e96;
    --border: #262c38; --ok: #40c057;
  }
  * { box-sizing: border-box; }
  body { background: var(--bg); color: var(--text); font-family: -apple-system, "Segoe UI", Roboto, sans-serif;
          max-width: 960px; margin: 0 auto; padding: 2rem 1.5rem 4rem; line-height: 1.55; }
  h1 { font-size: 1.8rem; border-bottom: 1px solid var(--border); padding-bottom: .5rem; }
  h2 { font-size: 1.3rem; margin-top: 2.5rem; border-bottom: 1px solid var(--border); padding-bottom: .3rem; }
  h3 { font-size: 1.05rem; margin-bottom: .3rem; }
  table { border-collapse: collapse; width: 100%; margin: 1rem 0; }
  th, td { border: 1px solid var(--border); padding: .45rem .65rem; text-align: left; font-size: .92rem; vertical-align: top; }
  th { background: var(--panel); }
  code { background: var(--panel); border-radius: 4px; padding: .1rem .35rem; font-size: .88em; }
  a { color: #4dabf7; }
  .meta-table td:first-child { color: var(--muted); width: 220px; }
  .badge { display: inline-block; padding: .15rem .55rem; border-radius: 3px; font-size: .75rem;
           font-weight: 700; text-transform: uppercase; letter-spacing: .02em; }
  .badge-critical { background: var(--crit); color: #fff; }
  .badge-high { background: var(--high); color: #1a1a1a; }
  .badge-medium { background: var(--med); color: #1a1a1a; }
  .badge-low { background: var(--low); color: #1a1a1a; }
  .badge-info { background: var(--info); color: #fff; }
  .confirmed-yes { color: var(--ok); font-weight: 600; }
  .confirmed-no { color: var(--muted); }
  .finding-card { border: 1px solid var(--border); border-radius: 6px; padding: 1rem 1.2rem; margin: 1rem 0; background: var(--panel); }
  .finding-card h3 { margin-top: 0; }
  .remediation { background: rgba(64,192,87,.08); border-left: 3px solid var(--ok); padding: .6rem .9rem; margin-top: .8rem; border-radius: 0 4px 4px 0; }
  .evidence-list { font-size: .88rem; color: var(--muted); }
  .muted { color: var(--muted); }
  .asset-group { margin-bottom: 1.2rem; }
  .asset-values { columns: 2; column-gap: 2rem; font-size: .88rem; }
  footer { margin-top: 3rem; padding-top: 1rem; border-top: 1px solid var(--border); color: var(--muted); font-size: .85rem; }
</style>
</head>
<body>

<h1>Scorpion Bug Hunter &mdash; Report for {{ target.raw_input }}</h1>

<table class="meta-table">
  <tr><td>Program</td><td>{{ target.program_name or "(not set)" }}</td></tr>
  <tr><td>Target status</td><td>{{ target.status }}</td></tr>
  <tr><td>Report generated</td><td>{{ generated_at }}</td></tr>
  <tr><td>Generated by</td><td>{{ generated_by }}</td></tr>
  <tr><td>Assets discovered</td><td>{{ asset_count }}</td></tr>
  <tr><td>Tool invocations</td><td>{{ scan_count }}</td></tr>
  <tr><td>Findings</td><td>{{ total_findings }} ({{ confirmed_count }} confirmed, {{ total_findings - confirmed_count }} need manual verification)</td></tr>
</table>

<h2>Executive summary</h2>
{% if total_findings == 0 %}
<p>No findings were recorded for this target. This means the tool chain ran clean
against everything it discovered in scope &mdash; it does <strong>not</strong> mean the
target has no vulnerabilities, only that nothing in this tool set's coverage
triggered. See <strong>Tool coverage</strong> below for exactly what ran (and what was
skipped because a binary wasn't installed) before treating this as a clean bill
of health.</p>
{% else %}
<p>{{ total_findings }} finding(s) were recorded across {{ asset_count }} discovered
asset(s), {{ confirmed_count }} of which were directly confirmed by the tool that
found them (the rest were flagged heuristically and need manual verification).</p>
<table>
  <tr><th>Severity</th><th>Count</th></tr>
  <tr><td><span class="badge badge-critical">critical</span></td><td>{{ severity_counts.get("critical", 0) }}</td></tr>
  <tr><td><span class="badge badge-high">high</span></td><td>{{ severity_counts.get("high", 0) }}</td></tr>
  <tr><td><span class="badge badge-medium">medium</span></td><td>{{ severity_counts.get("medium", 0) }}</td></tr>
  <tr><td><span class="badge badge-low">low</span></td><td>{{ severity_counts.get("low", 0) }}</td></tr>
  <tr><td><span class="badge badge-info">info</span></td><td>{{ severity_counts.get("info", 0) }}</td></tr>
</table>
{% endif %}

<h2>Tool coverage</h2>
<p class="muted">Every tool invocation recorded against this target. Raw output for each
individual run lives under <code>raw/</code> next to this report; the full ordered chain
is in <code>steps.log</code> / <code>steps.jsonl</code>.</p>
<table>
  <tr><th>Tool</th><th>Tier</th><th>Runs</th><th>Completed</th><th>Skipped</th><th>Failed</th><th>Total time</th></tr>
  {% for row in tool_coverage %}
  <tr>
    <td>{{ row.tool_name }}</td><td>{{ row.tier }}</td><td>{{ row.total_runs }}</td>
    <td>{{ row.completed }}</td><td>{{ row.skipped }}</td><td>{{ row.failed }}</td>
    <td>{{ "%.1f"|format(row.total_seconds) }}s</td>
  </tr>
  {% endfor %}
</table>

<h2>Asset inventory</h2>
{% for group in asset_inventory %}
<div class="asset-group">
  <h3>{{ group.type | capitalize }} ({{ group.count }})</h3>
  <div class="asset-values">
    {% for value in group.entries %}
    <div><code>{{ value }}</code></div>
    {% endfor %}
  </div>
</div>
{% endfor %}

<h2>Findings</h2>
{% if total_findings == 0 %}
<p>No findings to report for this target.</p>
{% else %}
{% for finding in findings %}
<div class="finding-card">
  <h3><span class="badge badge-{{ finding.severity }}">{{ finding.severity }}</span> {{ finding.title }}</h3>
  <table class="meta-table">
    <tr><td>Asset</td><td><code>{{ finding.asset_value }}</code> ({{ finding.asset_type }})</td></tr>
    <tr><td>Tier</td><td>{{ finding.tier }}</td></tr>
    <tr><td>Detected by</td><td>{{ finding.tool_name or "unknown" }}</td></tr>
    <tr><td>Confirmed</td>
        <td>{% if finding.confirmed %}<span class="confirmed-yes">Yes &mdash; directly observed by the tool</span>
            {% else %}<span class="confirmed-no">No &mdash; heuristic/unconfirmed, verify manually</span>{% endif %}</td></tr>
  </table>
  <p>{{ finding.description or "(no additional detail from the tool)" }}</p>
  <div class="remediation"><strong>Suggested remediation:</strong> {{ finding.remediation }}</div>
  <p class="evidence-list">
    {% if finding.evidence %}
      <strong>Evidence:</strong>
      {% for ev in finding.evidence %}<br>&bull; {{ ev.type }}: <code>{{ ev.file_path }}</code>{% endfor %}
    {% else %}
      <strong>Evidence:</strong> raw tool output for this run is under <code>raw/</code> (see <code>steps.log</code> for the exact file).
    {% endif %}
  </p>
</div>
{% endfor %}
{% endif %}

<footer>
  Findings above come from automated tooling and are a starting point for manual
  triage, not a substitute for it &mdash; especially anything marked "unconfirmed."
  Only scan targets you are authorized to test. Generated by {{ generated_by }}.
</footer>

</body>
</html>
